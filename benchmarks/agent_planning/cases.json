{
  "description": "Planning benchmark of Leonardo's AI assistant (leonardo.agent.plan_eval). Each case: a request, the structures loaded first (scene, paths relative to the repository), and what a good plan contains: 'all' (one tool of each group), 'order' (first use of a before b), 'none' (must not appear), 'prefer' (good practice, reported only). needs_plan false: a read-only answer without a plan is fine.",
  "cases": [
    {"id": "dock_cox2_ibuprofen", "lang": "es",
     "request": "Haz docking de ibuprofeno en la ciclooxigenasa-2 (PDB 5KIR) y dime la mejor pose.",
     "expect": {"all": [["fetch_structure"], ["find_pockets"], ["select_pocket", "set_docking_box"],
                        ["set_ligand_from_smiles", "use_pubchem_compound", "prepare_docking_ligand"], ["run_docking"]],
                "order": [["fetch_structure", "find_pockets"], ["find_pockets", "run_docking"]],
                "none": ["run_md", "run_abfe"], "prefer": ["prepare_protein", "analyze_interactions"]}},
    {"id": "redock_3ptb", "lang": "en", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Redock the crystal benzamidine of 3PTB and tell me whether the docking protocol reproduces the crystal pose.",
     "expect": {"all": [["run_redocking"]], "none": ["run_md", "run_abfe", "run_virtual_screening"]}},
    {"id": "interactions_2d_3ptb", "lang": "es", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "¿Qué interacciones hace la benzamidina con la tripsina? Muéstralas también en un diagrama 2D.",
     "expect": {"all": [["analyze_interactions"], ["show_2d_interaction_map"]],
                "order": [["analyze_interactions", "show_2d_interaction_map"]],
                "none": ["run_docking", "run_md", "run_redocking"]}},
    {"id": "screen_smiles_3ptb", "lang": "en", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Screen these compounds against the S1 pocket of trypsin and show me the interactions of the best hit: NC(=N)c1ccccc1, NC(=N)c1ccc(N)cc1, NC(=N)c1ccc(O)cc1, CC(=O)Nc1ccc(O)cc1, NCc1ccccc1.",
     "expect": {"all": [["find_pockets"], ["select_pocket", "set_docking_box"], ["run_virtual_screening"],
                        ["show_screening_hit"]],
                "order": [["find_pockets", "run_virtual_screening"], ["run_virtual_screening", "show_screening_hit"]],
                "none": ["run_md", "run_abfe"]}},
    {"id": "cryptic_then_dock_1aki", "lang": "es", "scene": ["examples/gpu_validation/1AKI.pdb"],
     "request": "¿Dónde podría unirse un fármaco que no se vea en esta estructura de lisozima? Luego haz docking de ibuprofeno en el mejor sitio.",
     "expect": {"all": [["find_cryptic_pockets"], ["find_pockets"], ["set_docking_box", "select_pocket"],
                        ["set_ligand_from_smiles", "use_pubchem_compound", "prepare_docking_ligand"], ["run_docking"]],
                "order": [["find_cryptic_pockets", "run_docking"], ["find_pockets", "run_docking"]],
                "none": ["run_abfe"]}},
    {"id": "lead_opt_3ptb", "lang": "en", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Optimize benzamidine as a trypsin inhibitor: generate analogs, dock them in the S1 pocket and rank them.",
     "expect": {"all": [["find_pockets"], ["select_pocket", "set_docking_box"], ["run_lead_optimization"]],
                "order": [["find_pockets", "run_lead_optimization"]], "none": ["run_md", "run_abfe"]}},
    {"id": "pka_ibuprofen", "lang": "es",
     "request": "Calcula el pKa del ibuprofeno y dime qué carga tiene a pH 7.4.",
     "expect": {"all": [["compute_pka"]], "none": ["run_docking", "fetch_structure", "run_psi4", "run_md"]}},
    {"id": "druglike_aspirin", "lang": "en", "needs_plan": false,
     "request": "Is aspirin drug-like? Check Lipinski's rules for it.",
     "expect": {"all": [["druglikeness"]], "none": ["run_docking", "run_psi4", "fetch_structure"]}},
    {"id": "md_stability_1aki", "lang": "es", "scene": ["examples/gpu_validation/1AKI.pdb"],
     "request": "Corre una dinámica molecular corta de la lisozima y dime si es estable (RMSD y RMSF).",
     "expect": {"all": [["run_md"], ["trajectory_rmsd_rmsf"]], "order": [["run_md", "trajectory_rmsd_rmsf"]],
                "none": ["run_docking", "run_abfe"], "prefer": ["prepare_protein", "check_simulation_system"]}},
    {"id": "md_saltbridge_3ptb", "lang": "en", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Run MD of the trypsin-benzamidine complex and tell me how often the salt bridge with Asp189 is kept.",
     "expect": {"all": [["run_md"], ["trajectory_interaction_occupancy", "interaction_distribution", "trajectory_distance"]],
                "order": [["run_md", "trajectory_interaction_occupancy"], ["run_md", "interaction_distribution"],
                          ["run_md", "trajectory_distance"]],
                "none": ["run_docking", "run_abfe"], "prefer": ["prepare_protein"]}},
    {"id": "abfe_3ptb", "lang": "en", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Estimate the binding free energy of benzamidine to trypsin.",
     "expect": {"all": [["parametrize_ligand"], ["run_abfe"]], "order": [["parametrize_ligand", "run_abfe"]],
                "none": ["run_virtual_screening"]}},
    {"id": "prepare_ph45_1aki", "lang": "es", "scene": ["examples/gpu_validation/1AKI.pdb"],
     "request": "Prepara la lisozima a pH 4.5 para simularla después.",
     "expect": {"all": [["prepare_protein"]], "none": ["run_md", "run_docking", "run_abfe"]}},
    {"id": "mutant_md_1ubq", "lang": "en",
     "request": "Fetch ubiquitin (1UBQ), make the K48R mutant and compare its stability with the wild type using short MD runs.",
     "expect": {"all": [["fetch_structure"], ["model_mutant"], ["run_md"], ["trajectory_rmsd_rmsf"]],
                "order": [["fetch_structure", "model_mutant"], ["model_mutant", "run_md"], ["run_md", "trajectory_rmsd_rmsf"]],
                "none": ["run_docking", "run_abfe"]}},
    {"id": "membrane_2rh1", "lang": "es",
     "request": "Mete el receptor beta-2 adrenérgico (PDB 2RH1) en una membrana de POPC y equilíbralo.",
     "expect": {"all": [["fetch_structure"], ["build_membrane_system"], ["equilibrate_membrane_system"]],
                "order": [["fetch_structure", "build_membrane_system"], ["build_membrane_system", "equilibrate_membrane_system"]],
                "none": ["run_docking"]}},
    {"id": "umbrella_3ptb", "lang": "en", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Run umbrella sampling of benzamidine leaving the trypsin pocket.",
     "expect": {"all": [["run_enhanced_sampling"]], "none": ["run_docking", "run_virtual_screening"]}},
    {"id": "dft_orbitals_caffeine", "lang": "es",
     "request": "Optimiza la geometría de la cafeína con DFT y muéstrame el HOMO y el LUMO.",
     "expect": {"all": [["set_ligand_from_smiles", "use_pubchem_compound", "fetch_structure", "load_structure_file"],
                        ["run_psi4"], ["show_orbitals"]],
                "order": [["run_psi4", "show_orbitals"]], "none": ["run_docking", "run_md"]}},
    {"id": "ir_acetone_semiempirical", "lang": "en",
     "request": "Quick IR spectrum of acetone, semiempirical is fine.",
     "expect": {"all": [["set_ligand_from_smiles", "use_pubchem_compound"], ["run_mopac"], ["show_ir_spectrum"]],
                "order": [["run_mopac", "show_ir_spectrum"]], "none": ["run_psi4", "run_md"]}},
    {"id": "qmmm_3ptb", "lang": "es", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Calcula con QM/MM la energía de la benzamidina en el sitio de la tripsina.",
     "expect": {"all": [["run_qmmm"]], "none": ["run_docking", "run_md"],
                "prefer": ["preview_qm_region", "plan_qm_region"]}},
    {"id": "uv_benzene_tddft", "lang": "en",
     "request": "UV-vis spectrum of benzene with TDDFT.",
     "expect": {"all": [["set_ligand_from_smiles", "use_pubchem_compound"], ["run_uv_spectrum"]],
                "none": ["run_mopac", "run_md"]}},
    {"id": "cluster_reaction_3ptb", "lang": "es", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Quiero modelar una reacción en el sitio activo de la tripsina con un clúster QM (Ser195, His57 y Asp102).",
     "expect": {"all": [["build_reaction_cluster"], ["run_cluster_reaction"]],
                "order": [["build_reaction_cluster", "run_cluster_reaction"]], "none": ["run_docking", "run_md"]}},
    {"id": "homology_rama", "lang": "en",
     "request": "Build a homology model of UniProt P69905 (hemoglobin alpha) and validate it with a Ramachandran plot.",
     "expect": {"all": [["get_uniprot_sequence", "search_templates"], ["build_homology_model"], ["ramachandran_plot"]],
                "order": [["build_homology_model", "ramachandran_plot"]], "none": ["run_md", "run_docking"]}},
    {"id": "alphafold_seq", "lang": "es",
     "request": "Predice la estructura de esta secuencia con AlphaFold: MKTAYIAKQRQISFVKSHFSRQLEERLGLIEVQAPILSRVGDGTQDNLSGAEKAVQVKVKALPDAQFEVVHSLAKWKRQTLGQHDFSAGEGLYTHMKALRPDEDRLSPLHSVYVDQWDWERVMGDGERQFSTLKSTVEAIWAGIKATEAAVSEEFGLAPFLPDQIHFVHSQELLSRYPDLDAKGRERAIAKDLGAVFLVGIGGKLSDGHRHDVRAPDYDDWWAELIVLSAWIHEKAHLRGQRVLFAREMVGSPMLKVATSPT",
     "expect": {"all": [["predict_structure_alphafold", "prepare_af3_input"]], "none": ["run_md", "run_docking"]}},
    {"id": "check_before_md_1aki", "lang": "en", "needs_plan": false, "scene": ["examples/gpu_validation/1AKI.pdb"],
     "request": "Check this structure for problems before I simulate it. Do not run anything long.",
     "expect": {"all": [["check_simulation_system", "analyze_protein_structure"]], "none": ["run_md", "minimize_structure"]}},
    {"id": "surface_view_3ptb", "lang": "es", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Muestra la tripsina como superficie, colorea los residuos hidrofóbicos y centra la vista en el sitio S1.",
     "expect": {"all": [["show_representation", "style_scene", "show_scene"], ["color_selection", "highlight_residues", "style_scene"],
                        ["focus_view", "show_scene"]],
                "none": ["run_md", "run_docking", "find_pockets"]}},
    {"id": "interface_1brs", "lang": "en",
     "request": "Analyze the barnase-barstar interface in 1BRS: salt bridges, hydrogen bonds and buried area.",
     "expect": {"all": [["fetch_structure"], ["analyze_interface"]], "order": [["fetch_structure", "analyze_interface"]],
                "none": ["run_md", "run_docking"]}},
    {"id": "gold_surface_1ubq", "lang": "es",
     "request": "Pon la ubiquitina (1UBQ) sobre una superficie de oro (111) con el extremo N-terminal hacia el oro.",
     "expect": {"all": [["fetch_structure"], ["build_protein_surface_system"]],
                "order": [["fetch_structure", "build_protein_surface_system"]], "none": ["run_docking"]}},
    {"id": "disulfides_1aki", "lang": "en", "scene": ["examples/gpu_validation/1AKI.pdb"],
     "request": "Design disulfide bonds that could stabilize this lysozyme.",
     "expect": {"all": [["design_disulfides"]], "none": ["run_docking", "run_abfe"]}},
    {"id": "estimate_md_cost_3ptb", "lang": "es", "needs_plan": false, "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "¿Cuánto tardaría en mi computador una dinámica de 10 ns en agua explícita de este sistema? No la corras.",
     "expect": {"all": [["estimate_cost"]], "none": ["run_md"]}},
    {"id": "interaction_figure_3ptb", "lang": "en", "scene": ["examples/3ptb_ben/3PTB.pdb"],
     "request": "Make a publication figure of the benzamidine-trypsin interactions.",
     "expect": {"all": [["analyze_interactions"], ["export_interaction_figure"]],
                "order": [["analyze_interactions", "export_interaction_figure"]], "none": ["run_docking", "run_md"]}}
  ]
}
