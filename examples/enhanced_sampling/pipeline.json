{
 "name": "Enhanced sampling: umbrella, metadynamics, GaMD and aMD on alanine dipeptide; umbrella on trypsin-benzamidine; ANI-2x MD",
 "slug": "enhanced_sampling",
 "description": "Runs every enhanced-sampling method of run_enhanced_sampling (action run) through Leonardo's tools: the \u03c6 free-energy profile of alanine dipeptide (amber14/GBn2, 300 K) by umbrella sampling (MBAR), well-tempered metadynamics, GaMD and aMD (cumulant reweighting), whose minima must agree, and a short umbrella sampling of the benzamidine-trypsin distance (ligand parameterized, calcium site restrained).",
 "format": 1,
 "parameters": {
  "pack": {
   "default": ".",
   "description": "this pack's folder (filled in by leonardo.replay)"
  }
 },
 "steps": [
  {
   "tool": "load_structure_file",
   "args": {
    "path": "{{pack}}/alanine_dipeptide.pdb",
    "object_name": "ala2"
   }
  },
  {
   "tool": "run_enhanced_sampling",
   "args": {
    "object": "ala2",
    "mode": "umbrella",
    "action": "run",
    "windows": 24,
    "force_constant_kj_mol_nm2": 150,
    "cv_start": -3.1416,
    "cv_end": 2.88,
    "equilibration_ps_per_window": 2,
    "production_ns_per_window": 0.02,
    "sample_stride_steps": 20,
    "cv_type": "dihedral",
    "cv_name": "phi",
    "selection_a": "resi 1 and name C",
    "selection_b": "resi 2 and name N",
    "selection_c": "resi 2 and name CA",
    "selection_d": "resi 2 and name C",
    "periodic": true
   }
  },
  {
